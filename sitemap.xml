<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static clean-URL sitemap fallback for Gimboot.

  Production note: this project is a Cloudflare Worker with static assets
  (wrangler.toml, `run_worker_first = ["/*"]`). The Worker handles
  GET /sitemap.xml dynamically and merges the root URL plus every catalog
  game's canonical /play/{id}/{slug} URL. This file is the correct fallback
  for a pure static deployment and is intentionally limited to those forms:

    - https://gimboot.com/ (root, trailing slash)
    - https://gimboot.com/play/{id}/{slug} (canonical game pages)

  Never add .html URLs, /game?id= query URLs, /emulator/ (not a search
  landing page), or duplicate spellings of a game slug.
-->
